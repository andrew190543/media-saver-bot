# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# --- Настройки прокси для скачивания сайтов (Windows local / Docker) ---
# На Windows используйте 127.0.0.1; в Docker на хост указывайте host.docker.internal.
PROXY_ENABLED=true
PROXY_URL=http://127.0.0.1:10809
# В Docker раскомментируйте:
# PROXY_URL=socks5://host.docker.internal:1080
PROXY_DOMAINS=youtube.com,youtu.be,instagram.com,twitter.com,x.com,soundcloud.com,pinterest.com,pin.it,tiktok.com

# Путь к файлу cookies (Netscape format)
COOKIES_FILE=cookies.txt

# Ограничения, таймауты и производительность
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_METADATA=4
MAX_ACTIVE_JOBS_PER_USER=2
DOWNLOAD_TIMEOUT=120
LOCAL_DOWNLOAD_TIMEOUT=1800
METADATA_TIMEOUT=35
COMPRESS_TIMEOUT=300
LOCAL_COMPRESS_TIMEOUT=1800
RATE_LIMIT_SECONDS=3.0
CALLBACK_RATE_LIMIT_SECONDS=1.5
MAX_RAW_DOWNLOAD_MB=2500
MAX_GALLERY_ITEMS=30
ALLOW_GENERIC_EXTRACTOR=false

# Лимит размера файла (48 МБ для стандартного API, до 1950 МБ для Local Bot API)
MAX_FILESIZE_MB=48
LOCAL_MAX_FILESIZE_MB=1950
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# --- Прокси для подключения к облачному Telegram API (TgWsProxy) ---
# Если TgWsProxy не используется или включён USE_LOCAL_BOT_API=true — оставьте пустым.
# На Windows: socks5://127.0.0.1:1443 ; в Docker: socks5://host.docker.internal:1443
TELEGRAM_PROXY_URL=
TELEGRAM_REQUEST_TIMEOUT=300.0
LOCAL_TELEGRAM_REQUEST_TIMEOUT=1800.0

# Путь к БД и временным файлам
# По умолчанию TEMP_DIR выбирается кросс-платформенно (в Linux/Docker это /tmp/media_saver_bot).
DB_PATH=data/bot.sqlite3
# В Docker при необходимости переопределения:
# TEMP_DIR=/tmp/media_saver_bot
