# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# Настройки прокси (SOCKS5 или HTTP) для обхода блокировок РФ.
# В Docker используйте host.docker.internal (прокси запущен на хосте).
# При запуске без Docker замените на 127.0.0.1.
PROXY_ENABLED=true
PROXY_URL=socks5://host.docker.internal:1080
PROXY_DOMAINS=youtube.com,youtu.be,instagram.com,twitter.com,x.com,soundcloud.com,pinterest.com,pin.it,tiktok.com

# Путь к файлу cookies (Netscape format)
COOKIES_FILE=cookies.txt

# Ограничения и производительность
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT=120
RATE_LIMIT_SECONDS=3.0

# Лимит размера файла (48 МБ для стандартного API, до 1950 МБ для Local Bot API)
MAX_FILESIZE_MB=48
LOCAL_MAX_FILESIZE_MB=1950
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# Прокси для подключения Telegram (локальный TgWsProxy).
# В Docker: host.docker.internal, без Docker: 127.0.0.1.
# Если TgWsProxy не используется — оставьте пустым: TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_URL=socks5://host.docker.internal:1443

# Путь к БД и временным файлам
DB_PATH=data/bot.sqlite3
TEMP_DIR=/tmp/media_saver_bot
